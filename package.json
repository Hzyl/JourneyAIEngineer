{
  "name": "journey-ai-engineer",
  "private": false,
  "version": "0.1.2",
  "description": "Local-first bilingual learning OS for becoming an AI Engineer.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-cloudflare-headers.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "validate": "python scripts/validate_content.py",
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test.ps1",
    "test:e2e": "playwright test",
    "test:unit": "vitest run src/test",
    "test:db": "supabase test db",
    "test:e2e:hosted": "playwright test --config=playwright.hosted.config.ts",
    "test:e2e:production": "playwright test --config=playwright.production.config.ts",
    "supabase:types": "node scripts/generate-database-types.mjs",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package_release.ps1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "supabase": "^2.119.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
